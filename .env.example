# Copier ce fichier en .env.local (jamais committé) puis renseigner les valeurs.

# URL publique du site (utilisée pour sitemap, Open Graph, canonical).
# Exemple : https://learnmore-data.vercel.app  -> à ajuster selon le nom disponible sur Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Formulaire de contact (service Resend, https://resend.com) ---
# Tant que ces trois variables ne sont pas toutes renseignées, le formulaire
# répond « non configuré » et propose un lien e-mail de secours : aucun envoi factice.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Expéditeur vérifié dans Resend (ex. "Portfolio <contact@votre-domaine.com>")
CONTACT_FROM_EMAIL=
